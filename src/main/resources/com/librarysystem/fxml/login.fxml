<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Text?>

<StackPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.librarysystem.controller.LoginController"
           prefWidth="850.0" prefHeight="550.0"
           styleClass="root">

    <HBox alignment="CENTER" spacing="0">
        <!-- Brand/Welcome Side (Indigo Background) -->
        <VBox alignment="CENTER" prefWidth="400.0" spacing="20"
              style="-fx-background-color: linear-gradient(to bottom, #4f46e5, #312e81); -fx-padding: 40px;">
            <Text text="📚" style="-fx-font-size: 60px; -fx-fill: white;"/>
            <Label text="Athena Library" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: white;"/>
            <Label text="Knowledge is power. Information is liberating."
                   style="-fx-text-fill: #cbd5e1; -fx-font-size: 13px; -fx-wrap-text: true; -fx-text-alignment: center;"/>
            <Separator opacity="0.2" prefWidth="150.0"/>
            <Label text="System Version 1.0.0" style="-fx-text-fill: #94a3b8; -fx-font-size: 11px;"/>
        </VBox>

        <!-- Login Form Side -->
        <VBox alignment="CENTER_LEFT" prefWidth="450.0" spacing="25" style="-fx-background-color: -color-bg; -fx-padding: 50px;">
            <VBox spacing="5">
                <Label text="Welcome Back" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: -color-text;"/>
                <Label text="Please login to access the library dashboard." styleClass="label-secondary"/>
            </VBox>

            <VBox spacing="15">
                <VBox spacing="5">
                    <Label text="Username" style="-fx-font-weight: bold; -fx-text-fill: -color-text;"/>
                    <TextField fx:id="txtUsername" promptText="Enter your username" styleClass="text-field" prefHeight="40.0"/>
                </VBox>

                <VBox spacing="5">
                    <Label text="Password" style="-fx-font-weight: bold; -fx-text-fill: -color-text;"/>
                    <PasswordField fx:id="txtPassword" promptText="Enter your password" styleClass="password-field" prefHeight="40.0"/>
                </VBox>
            </VBox>

            <HBox alignment="CENTER_RIGHT">
                <Button text="Sign In" onAction="#handleLogin" styleClass="btn-primary" prefHeight="40.0" prefWidth="120.0"/>
            </HBox>
        </VBox>
    </HBox>
</StackPane>
